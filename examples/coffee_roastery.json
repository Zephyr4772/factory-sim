    {"id": "roaster_1", "type": "machine", "label": "Roaster 1", "x": 370, "y": 155, "capacity": 3, "process_by_type": {"arabica": {"dist": "normal", "mean": 720, "stddev": 60}, "robusta": {"dist": "normal", "mean": 600, "stddev": 60}, "decaf": {"dist": "normal", "mean": 780, "stddev": 60}}, "setup": 240, "mtbf": 28800, "mttr": 1800, "downstream": ["cooling"]},
    {"id": "roaster_2", "type": "machine", "label": "Roaster 2", "x": 370, "y": 365, "capacity": 3, "process_by_type": {"arabica": {"dist": "normal", "mean": 720, "stddev": 60}, "robusta": {"dist": "normal", "mean": 600, "stddev": 60}, "decaf": {"dist": "normal", "mean": 780, "stddev": 60}}, "setup": 240, "mtbf": 28800, "mttr": 1800, "downstream": ["cooling"]},
